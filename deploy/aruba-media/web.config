<?xml version="1.0" encoding="UTF-8"?>
<!-- Timet media origin — IIS / Windows shared hosting.
     Place this file in the folder that serves the audio (e.g. media.timet.org/audio/). -->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, HEAD, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Range, Content-Type" />
        <add name="Access-Control-Expose-Headers" value="Content-Length, Content-Range, Accept-Ranges" />
        <add name="Accept-Ranges" value="bytes" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
